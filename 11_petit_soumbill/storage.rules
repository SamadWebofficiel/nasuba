rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Tout le monde peut lire les médias
    match /{allPaths=**} {
      allow read: if true;
    }

    // Seul l'admin peut uploader/modifier/supprimer
    match /products/{allPaths=**} {
      allow write: if request.auth != null 
                   // Limite à 50 Mo (pour les vidéos) et 5 Mo (pour les images, géré côté client pour le type exact, mais ici on met 50 Mo max strict)
                   && request.resource.size < 50 * 1024 * 1024
                   // Vérifie que c'est bien une image ou vidéo
                   && request.resource.contentType.matches('image/.*|video/.*');
    }
  }
}
